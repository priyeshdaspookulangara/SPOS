@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Z-Report (Daily Sales)";
}

<h1>@ViewData["Title"]</h1>
<h4>For @DateTime.Today.ToShortDateString()</h4>

<table class="table">
    <thead>
        <tr>
            <th>
                Payment Method
            </th>
            <th class="text-end">
                Total
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @item.PaymentMethod
            </td>
            <td class="text-end">
                @item.Total.ToString("C")
            </td>
        </tr>
}
    </tbody>
    <tfoot>
        <tr>
            <td><strong>Grand Total</strong></td>
            <td class="text-end"><strong>@Model.Sum(i => i.Total).ToString("C")</strong></td>
        </tr>
    </tfoot>
</table>