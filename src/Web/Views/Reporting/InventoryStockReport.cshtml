@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Inventory Stock Report";
}

<h1>@ViewData["Title"]</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                Material
            </th>
            <th>
                Quantity
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @item.Material.Description
            </td>
            <td>
                @item.Quantity
            </td>
        </tr>
}
    </tbody>
</table>