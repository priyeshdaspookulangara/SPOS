@model IEnumerable<Core.Entities.ChartOfAccounts>

@{
    ViewData["Title"] = "Chart of Accounts";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="CreateChartOfAccounts" class="btn btn-primary">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.AccountNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AccountType)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.AccountNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AccountType)
            </td>
            <td>
                <a asp-action="EditChartOfAccounts" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="DetailsChartOfAccounts" asp-route-id="@item.Id">Details</a> |
                <a asp-action="DeleteChartOfAccounts" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>