@model Core.Entities.Customer

@{
    ViewData["Title"] = "Customer Details";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Customer</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CustomerType)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CustomerType)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PhoneNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PhoneNumber)
        </dd>
    </dl>
</div>
<hr />
<h4>Addresses</h4>
<table class="table">
    @foreach (var item in Model.Addresses)
    {
        <tr>
            <td>@item.AddressType</td>
            <td>@item.Street, @item.City, @item.State @item.PostalCode</td>
        </tr>
    }
</table>
<hr />
<h4>Contacts</h4>
<table class="table">
    @foreach (var item in Model.Contacts)
    {
        <tr>
            <td>@item.FirstName @item.LastName</td>
            <td>@item.Email</td>
            <td>@item.PhoneNumber</td>
            <td>@item.Role</td>
        </tr>
    }
</table>
<hr />
<h4>Interaction History</h4>
<table class="table">
    @foreach (var item in Model.Interactions)
    {
        <tr>
            <td>@item.InteractionDate</td>
            <td>@item.InteractionType</td>
            <td>@item.Channel</td>
            <td>@item.Notes</td>
        </tr>
    }
</table>

<hr />
<partial name="_AddInteraction" model="Model" />

<div>
    <a asp-action="EditCustomer" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Customers">Back to List</a>
</div>