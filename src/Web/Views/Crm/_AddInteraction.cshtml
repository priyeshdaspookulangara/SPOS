@model Core.Entities.Customer

<h4>Add New Interaction</h4>
<form asp-action="AddInteraction" method="post">
    <input type="hidden" name="customerId" value="@Model.Id" />
    <div class="form-group">
        <label for="interactionType">Type</label>
        <input name="interactionType" class="form-control" />
    </div>
    <div class="form-group">
        <label for="channel">Channel</label>
        <input name="channel" class="form-control" />
    </div>
    <div class="form-group">
        <label for="notes">Notes</label>
        <textarea name="notes" class="form-control"></textarea>
    </div>
    <div class="form-group mt-3">
        <input type="submit" value="Add Interaction" class="btn btn-primary" />
    </div>
</form>