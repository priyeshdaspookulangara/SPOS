@model IEnumerable<Core.Entities.PurchaseRequisition>

@{
    ViewData["Title"] = "Purchase Requisitions";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="CreatePurchaseRequisition" class="btn btn-primary">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Material)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Quantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateRequested)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Material.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Quantity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateRequested)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @if (item.Status == "Pending")
                {
                    <form asp-action="ApprovePurchaseRequisition" asp-route-id="@item.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-success btn-sm">Approve</button>
                    </form>
                    <form asp-action="RejectPurchaseRequisition" asp-route-id="@item.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                    </form>
                }
                @if (item.Status == "Approved")
                {
                    <a asp-action="CreatePurchaseOrderFromRequisition" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Create PO</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>