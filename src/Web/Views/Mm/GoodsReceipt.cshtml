@model Core.Entities.PurchaseOrder

@{
    ViewData["Title"] = "Goods Receipt";
}

<h1>@ViewData["Title"]</h1>

<h4>Purchase Order: @Model.Id</h4>
<hr />
<div>
    <dl class="row">
        <dt class="col-sm-2">
            Material
        </dt>
        <dd class="col-sm-10">
            @Model.Material.Description
        </dd>
        <dt class="col-sm-2">
            Order Quantity
        </dt>
        <dd class="col-sm-10">
            @Model.Quantity
        </dd>
    </dl>
</div>

<div class="row">
    <div class="col-md-4">
        <form asp-action="GoodsReceipt" asp-route-id="@Model.Id">
            <div class="form-group">
                <label for="quantity" class="control-label">Received Quantity</label>
                <input name="quantity" class="form-control" value="@Model.Quantity" />
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Post Goods Receipt" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="PurchaseOrders">Back to List</a>
</div>